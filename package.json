{
  "name": "timkuel-paperback-extensions",
  "version": "0.0.0",
  "repositoryName": "Timkuel's Paperback Extensions (0.8)",
  "repository": "https://github.com/timkuel/PaperBackExtension",
  "baseURL": "https://timkuel.github.io/PaperBackExtension/0.8",
  "description": "Independent Paperback 0.8 extensions, based on Netsky's sources and maintained for MangaHub",
  "scripts": {
    "prebundle": "node scripts/prepare-bundles.cjs",
    "bundle": "paperback bundle --folder=0.8 --use-node-fs",
    "serve": "paperback serve",
    "test": "paperback test",
    "test:mangahub": "node --test tests/mangahub-pages.test.cjs",
    "typecheck": "tsc --noEmit --noUnusedLocals false"
  },
  "author": "timkuel (based on Netsky's extensions)",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "18.16.20",
    "@tsconfig/recommended": "^1.0.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^7.32.0",
    "eslint-plugin-modules-newline": "^0.0.6",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@paperback/toolchain": "^0.8.7",
    "@paperback/types": "^0.8.7",
    "cheerio": "^1.0.0",
    "html-entities": "^2.5.2"
  }
}
